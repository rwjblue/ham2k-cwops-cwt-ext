    "@ham2k/lib-format-tools": "^1.2.0",
    "@ham2k/lib-geo-tools": "^1.1.1",
    "@ham2k/lib-operation-data": "^1.1.3",
    "@ham2k/lib-qson-cabrillo": "^1.2.0",
    "i18next": "^23.16.8",
    "liquidjs": "^10.28.0"
  }
