#!/usr/bin/env bash
#MISE description="Set the GitHub Actions catalog secret from H2K_CATALOG_TOKEN"

set -euo pipefail
if [[ -z "${H2K_CATALOG_TOKEN:-}" ]]; then
  echo "Set H2K_CATALOG_TOKEN in .env.local first." >&2
  exit 1
fi

# Pass the token on stdin, never in command-line arguments or output.
printf '%s' "$H2K_CATALOG_TOKEN" | gh secret set H2K_CATALOG_TOKEN
